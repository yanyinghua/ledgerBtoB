[Unit]
Description=Ledger 往来账管理系统 (Django + gunicorn)
After=network.target

[Service]
# 运行用户：按需修改。轻量服务器可用 www-data 或新建专用用户 ledger。
User=www-data
Group=www-data

# 项目在服务器上的实际路径（git clone / scp 后的位置）
WorkingDirectory=/srv/ledger

# 生产环境变量（含 SECRET_KEY 等敏感项），务必 chmod 600 且仅 root 可读
EnvironmentFile=/etc/ledger/env

# gunicorn 走 unix socket，避免占用端口。
# workers 按内存调整（轻量 1~2G 内存用 2~3）。
# 注：早期为规避 SQLite 单库写锁并发冲突曾临时降到 --workers 1，
# 迁移 PostgreSQL 后该限制已不存在，恢复多 worker 以提升并发与单进程宕机容错。
ExecStart=/srv/ledger/venv/bin/gunicorn ledger.wsgi:application \
          --bind unix:/run/ledger/ledger.sock \
          --workers 2 \
          --threads 2 \
          --timeout 120 \
          --access-logfile /var/log/ledger/access.log \
          --error-logfile /var/log/ledger/error.log

# 自动创建 /run/ledger，供 socket 使用
RuntimeDirectory=ledger
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
