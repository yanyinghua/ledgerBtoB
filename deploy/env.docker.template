# ============================================================================
# 交付版环境变量模板（install.sh 会自动复制并填入随机值，一般无需手工编辑）
# ============================================================================

# Django 密钥：install.sh 生成；更换会导致已登录会话失效
DJANGO_SECRET_KEY=__GENERATE_SECRET_KEY__

# 调试开关：交付必须为 False
DJANGO_DEBUG=False

# 强制 HTTPS 跳转：默认关闭（交付包不带证书，开 True 会导致 http 访问被 301 到 https）。
# 配置好 HTTPS 证书后改为 True。
DJANGO_SECURE_SSL_REDIRECT=False

# 允许访问的域名/IP，多个用逗号分隔（局域网访问填 内网IP,localhost）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库（install.sh 会生成随机口令）
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=__GENERATE_DB_PASSWORD__

# 首次安装时自动创建的管理员账号（装好后请立即改密码，然后从 .env 里删掉这两行）
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# 短信后端：
#   console（默认）—— 验证码打印到容器日志，不真实发送、不产生费用，适合内部测试。
#   tencent        —— 腾讯云短信，需填写下方 TENCENT* 配置并把本项改为 tencent。
# ---------------------------------------------------------------------------
DJANGO_SMS_BACKEND=console

# 腾讯云短信（仅 DJANGO_SMS_BACKEND=tencent 时需要；密钥请勿提交到仓库）
# 在腾讯云控制台开通短信服务、实名认证，创建签名与验证码模板（模板内容如「您的验证码是${1}」）后获取：
#   SecretId/SecretKey：访问管理 → API 密钥管理
#   SdkAppId：短信控制台 → 应用列表
#   SignName：短信签名管理（已审核通过）
#   TemplateId：正文模板管理（已审核通过）
TENCENTCLOUD_SECRET_ID=__FILL_ME__
TENCENTCLOUD_SECRET_KEY=__FILL_ME__
TENCENT_SMS_SDK_APP_ID=__FILL_ME__
TENCENT_SMS_SIGN_NAME=__FILL_ME__
TENCENT_SMS_TEMPLATE_ID=__FILL_ME__
# 可选，默认 ap-guangzhou
TENCENT_SMS_REGION=ap-guangzhou

# nginx 映射到宿主的端口
HTTP_PORT=80
