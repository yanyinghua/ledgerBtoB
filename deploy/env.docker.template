# ============================================================================
# 交付版环境变量模板（install.sh 会自动复制并填入随机值，一般无需手工编辑）
# ============================================================================

# Django 密钥：install.sh 生成；更换会导致已登录会话失效
DJANGO_SECRET_KEY=__GENERATE_SECRET_KEY__

# 调试开关：交付必须为 False
DJANGO_DEBUG=False

# 强制 HTTPS 跳转：默认关闭（交付包不带证书，开 True 会导致 http 访问被 301 到 https）。
# 配置好 HTTPS 证书后改为 True。
DJANGO_SECURE_SSL_REDIRECT=False

# 允许访问的域名/IP，多个用逗号分隔（局域网访问填 内网IP,localhost）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库（install.sh 会生成随机口令）
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=__GENERATE_DB_PASSWORD__

# 首次安装时自动创建的管理员账号（装好后请立即改密码，然后从 .env 里删掉这两行）
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=admin123

# nginx 映射到宿主的端口
HTTP_PORT=80
