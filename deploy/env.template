# ============================================================================
# 生产环境变量模板
# 用法：
#   sudo mkdir -p /etc/ledger
#   sudo cp env.template /etc/ledger/env
#   sudo chmod 600 /etc/ledger/env
#   sudo chown root:root /etc/ledger/env
# 然后编辑 /etc/ledger/env，把 SECRET_KEY 换成真实值（见下方命令）。
# ============================================================================

# 1) SECRET_KEY：务必用独立长随机值，不要用开发回退值。生成命令：
#    python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'-_') for _ in range(64)))"
DJANGO_SECRET_KEY=__REPLACE_WITH_GENERATED_64CHAR_KEY__

# 2) 调试：生产必须为 False
DJANGO_DEBUG=False

# 3) 允许访问的域名（子域名）
DJANGO_ALLOWED_HOSTS=ledger.yanyinghuaerp.top

# 4) 强制 HTTPS 跳转 + HSTS（需 nginx 已配置 SSL）
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# ===== 可选 =====
# 备份保留策略（deploy.sh 与 scripts/run_backup.sh 共用；不设则用下列默认值）
# 实际保留 = 最近 BACKUP_KEEP 份 ∪ 最近 BACKUP_KEEP_DAYS 天每天最新一份 ∪ 每月最新一份
# BACKUP_KEEP=20
# BACKUP_KEEP_DAYS=14

# 数据库：默认 SQLite（BASE_DIR/db.sqlite3），轻量单服够用。
# 生产推荐 PostgreSQL：根治 gunicorn 重启瞬间抢 SQLite 锁导致的偶发 500。
# 启用时取消下方注释，并把密码换成真实值；同时服务器需已装好 PostgreSQL
# 并建好对应的库与角色（见 DEPLOY.md「迁移到 PostgreSQL」）。
# 注意：DJANGO_DB_ENGINE 缺省为 sqlite3，本地开发 / CI 无需设置。
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=ledger
# DJANGO_DB_USER=ledger
# DJANGO_DB_PASSWORD=__DB_PASSWORD__
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60
